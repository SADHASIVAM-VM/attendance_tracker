# ==========================================
# Server Environment Configuration
# ==========================================

# Port for the Express REST API
PORT=5000

# PostgreSQL Connection String (Optional for local development; embedded PostgreSQL PGlite is used automatically as fallback)
# Production PostgreSQL example:
# DATABASE_URL=postgresql://postgres:your_secure_password@localhost:5432/attendance_db
DATABASE_URL=

# Set to true if connecting to cloud PostgreSQL requiring TLS/SSL (e.g., Supabase, Neon, AWS RDS)
DB_SSL=false

# JSON Web Token secret for authenticated session tokens
JWT_SECRET=attendance_production_jwt_secret_change_me_2026

# Secret key for signing short-lived attendance photo upload & view tokens
STORAGE_SECRET=attendance_storage_signature_secret_change_me_2026

# Private S3-Compatible Object Storage for Attendance Selfies (Optional; secure local private vault is used when unconfigured)
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Application Logging Level (debug, info, warn, error)
LOG_LEVEL=info
